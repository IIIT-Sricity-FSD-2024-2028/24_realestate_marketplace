<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Dashboard - truEstate</title>
    <link rel="stylesheet" href="seller-dashboard.css">
</head>

<body>
    <div class="dashboard">
        <aside class="sidebar">
            <div class="logo-section">
                <div class="logo-icon">
                    <svg fill="none" stroke="#000000" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                </div>
                <div class="logo-text"><span class="bold">Tru</span><span>Estate</span><span
                        class="logo-badge">Seller</span></div>
            </div>
            <nav class="nav">
                <a href="#" data-page="dashboard" class="nav-item active" onclick="switchPage(event, 'dashboard')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                    <span>Dashboard</span>
                    <div class="nav-indicator"></div>
                </a>

                <button class="dropdown-btn" onclick="toggleDropdown('properties')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span style="flex: 1; text-align: left;">Properties</span>
                    <svg id="properties-icon" style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                <div id="properties" class="dropdown-content open">
                    <a href="#" data-page="my-listings" class="dropdown-item"
                        onclick="switchPage(event, 'my-listings')"><span>My Listings</span></a>
                </div>

                <button class="dropdown-btn" onclick="toggleDropdown('buyerMgmt')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <span style="flex: 1; text-align: left;">Buyer Management</span>
                    <svg id="buyerMgmt-icon" style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                <div id="buyerMgmt" class="dropdown-content open">
                    <a href="#" data-page="negotiate" class="dropdown-item"
                        onclick="switchPage(event, 'negotiate')"><span>Negotiate</span></a>
                    <a href="#" data-page="track-payment" class="dropdown-item"
                        onclick="switchPage(event, 'track-payment')"><span>Track Payment</span></a>
                </div>

                <button class="dropdown-btn" onclick="toggleDropdown('soldRented')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    <span style="flex: 1; text-align: left;">Sold/Rented</span>
                    <svg id="soldRented-icon" style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                <div id="soldRented" class="dropdown-content open">
                    <a href="#" data-page="sold" class="dropdown-item" onclick="switchPage(event, 'sold')"><span>Sold
                            Properties</span></a>
                    <a href="#" data-page="rent-given" class="dropdown-item"
                        onclick="switchPage(event, 'rent-given')"><span>Rent Given Properties</span></a>
                </div>

                <a href="#" data-page="billing" class="nav-item" onclick="switchPage(event, 'billing')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="1" y="4" width="22" height="16" rx="2" />
                        <line x1="1" y1="10" x2="23" y2="10" />
                    </svg>
                    <span>Billing &amp; Plans</span>
                </a>
                <a href="#" data-page="notifications" class="nav-item" onclick="switchPage(event, 'notifications')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span>Notifications</span>
                </a>
                <a href="#" data-page="profile" class="nav-item" onclick="switchPage(event, 'profile')">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <span>Profile</span>
                </a>
            </nav>
            <div class="user-section">
                <div class="user-profile">
                    <div class="user-avatar">SJ</div>
                    <div class="user-info">
                        <div class="user-name" id="sidebar-user-name">Sarah Johnson</div>
                        <div class="user-type">Seller Account</div>
                    </div>
                </div>
                <button class="logout-btn" onclick="TruEstate.logout('seller')">
                    <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" stroke-width="2"
                        viewBox="0 0 24 24">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    <span>Logout</span>
                </button>
            </div>
        </aside>

        <main class="main-content">
            <!-- Dashboard Page -->
            <div id="page-dashboard" class="page-content active">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">Seller Dashboard</h1>
                        <p class="page-subtitle">Welcome back, <span id="dash-welcome-name">Sarah Johnson</span>! Here's your overview</p>
                    </div>
                    <div class="user-avatar" style="width:2.5rem;height:2.5rem;">SJ</div>
                </div>
                <div class="content-section">
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon-box" style="background-color: rgba(29,185,84,0.2);"><svg fill="none"
                                    stroke="#1DB954" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                    <polyline points="9 22 9 12 15 12 15 22" />
                                </svg></div>
                            <div class="stat-label">Total Listings</div>
                            <div class="stat-value">12</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon-box" style="background-color: rgba(29,185,84,0.2);"><svg fill="none"
                                    stroke="#1DB954" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                </svg></div>
                            <div class="stat-label">Active Listings</div>
                            <div class="stat-value">8</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon-box" style="background-color: rgba(249,115,22,0.2);"><svg fill="none"
                                    stroke="#f97316" stroke-width="2" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg></div>
                            <div class="stat-label">Pending Review</div>
                            <div class="stat-value">3</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon-box" style="background-color: rgba(29,185,84,0.2);"><svg fill="none"
                                    stroke="#1DB954" stroke-width="2" viewBox="0 0 24 24">
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg></div>
                            <div class="stat-label">Total Revenue</div>
                            <div class="stat-value">₹6.25 Cr</div>
                        </div>
                    </div>

                    <!-- Recent Listings Table -->
                    <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">Recent Listings</h2>
                    <div class="card" style="padding: 0; overflow: hidden;">
                        <table>
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Location</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="recent-listings-table">
                                <tr><td colspan="4" style="text-align:center;color:#9ca3af;padding:1.5rem;">Loading…</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- My Listings Page -->
            <div id="page-my-listings" class="page-content">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">My Listings</h1>
                        <p class="page-subtitle">Create and manage your property listings</p>
                        <div id="quota-notice-listings" class="quota-notice" style="display:none;margin-top:1rem;"></div>
                    </div>
                </div>
                <div class="content-section">
                    <div class="card" style="text-align: center; padding: 3rem;">
                        <div
                            style="width: 4rem; height: 4rem; border-radius: 9999px; background-color: #1DB954; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                            <svg style="width: 2rem; height: 2rem;" fill="none" stroke="#000" stroke-width="3"
                                viewBox="0 0 24 24">
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                        </div>
                        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">Create New Property
                            Listing</h2>
                        <p style="color: #9ca3af; margin-bottom: 1.5rem;">List your property for sale or rent. Fill out
                            the details and submit for admin review.</p>
                        <button class="btn-primary" onclick="switchPage(event, 'add-property')">+ Add New
                            Property</button>
                    </div>
                    <!-- Filter pills -->
                    <div style="display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                        <button class="pill pill-active" data-status="all" onclick="filterListings(this, 'all')">All <span class="count"
                                id="pill-count-all">0</span></button>
                        <button class="pill pill-inactive" data-status="approved" onclick="filterListings(this, 'approved')">Approved <span
                                class="count" id="pill-count-approved">0</span></button>
                        <button class="pill pill-inactive" data-status="pending" onclick="filterListings(this, 'pending')">Pending <span
                                class="count" id="pill-count-pending">0</span></button>
                        <button class="pill pill-inactive" data-status="rejected" onclick="filterListings(this, 'rejected')">Rejected <span
                                class="count" id="pill-count-rejected">0</span></button>
                    </div>
                    <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">All Properties</h2>
                    <div class="card" style="padding: 0; overflow: hidden;">
                        <table>
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Type</th>
                                    <th>Location</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="listings-table">
                                <tr><td colspan="6" style="text-align:center;color:#9ca3af;padding:1.5rem;">Loading…</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add New Property Form -->
            <div id="page-add-property" class="page-content">
                <div class="content-section">
                    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.5rem;"><button
                            onclick="switchPage(event,'my-listings')"
                            style="background:none;border:none;color:#9ca3af;cursor:pointer;font-size:1.25rem;padding:0.5rem;">←</button>
                        <h1 class="page-title" style="margin-bottom:0;">Add New Property</h1>
                    </div>
                    <p class="page-subtitle" style="margin-bottom:2rem;margin-left:2.75rem;">Fill in the details to
                        create a new listing</p>
                    <!-- Plan quota, shown before the form rather than only on rejection.
                         Hitting the limit at submit time — after filling in a long form — is
                         the worst moment to learn about it. -->
                    <div id="quota-notice" class="quota-notice" style="display:none;"></div>
                    <form id="addPropertyForm" onsubmit="submitNewProperty(event)">
                        <!-- Basic Information -->
                        <div class="card" style="margin-bottom:1.5rem;">
                            <h2
                                style="font-size:1.125rem;font-weight:700;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                                <span style="color:#1DB954;">🏠</span> Basic Information
                            </h2>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Property
                                        Name *</label><input id="new-prop-name" type="text"
                                        placeholder="e.g., Luxury 3BHK Apartment" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Property
                                        Type *</label><select id="new-prop-type" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;appearance:auto;">
                                        <option>Apartment</option>
                                        <option>Villa</option>
                                        <option>Penthouse</option>
                                        <option>Plot</option>
                                        <option>Commercial</option>
                                    </select></div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Transaction
                                        Type *</label><select id="new-prop-transaction" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;appearance:auto;">
                                        <option value="sale">Sell</option>
                                        <option value="rent">Rent</option>
                                    </select></div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Status
                                        *</label><select id="new-prop-readiness" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;appearance:auto;">
                                        <option>Ready to Move</option>
                                        <option>Under Construction</option>
                                    </select></div>
                            </div>
                        </div>
                        <!-- Location Details -->
                        <div class="card" style="margin-bottom:1.5rem;">
                            <h2
                                style="font-size:1.125rem;font-weight:700;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                                <span style="color:#1DB954;">📍</span> Location Details
                            </h2>
                            <!-- truEstate has launched in four cities only, each run by its own
                                 admin, so the city is a fixed choice rather than free text — a
                                 listing anywhere else would have nobody to verify it. The state
                                 follows from the city and is shown read-only. -->
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;">
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">City
                                        *</label><select id="new-prop-location" required
                                        onchange="syncPropertyState()"
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                        <option value="">Select a city</option>
                                        <option value="Hyderabad">Hyderabad</option>
                                        <option value="Chennai">Chennai</option>
                                        <option value="Bangalore">Bangalore</option>
                                        <option value="Kochi">Kochi</option>
                                    </select>
                                    <span
                                        style="display:block;font-size:0.75rem;color:#6b7280;margin-top:0.4rem;">We
                                        currently operate in these four cities only.</span>
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">State</label><input
                                        id="new-prop-state" type="text" readonly
                                        placeholder="Set by the city you pick"
                                        style="width:100%;background:#141414;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#9ca3af;font-size:0.875rem;cursor:not-allowed;">
                                </div>
                            </div>
                            <div><label
                                    style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Full
                                    Address *</label><input id="new-prop-address" type="text"
                                    placeholder="e.g., 123 Main Street, Sector 5, Banjara Hills" required
                                    style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                            </div>
                        </div>
                        <!-- Property Details -->
                        <div class="card" style="margin-bottom:1.5rem;">
                            <h2
                                style="font-size:1.125rem;font-weight:700;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                                <span style="color:#1DB954;">⚙️</span> Property Details
                            </h2>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Price
                                        (₹) *</label><input id="new-prop-price" type="text"
                                        placeholder="e.g., 1,25,00,000" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Super
                                        Area (sqft) *</label><input id="new-prop-sqft" type="text"
                                        placeholder="e.g., 1500" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Bedrooms
                                        *</label><input id="new-prop-beds" type="text" placeholder="e.g., 3" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Bathrooms
                                        *</label><input id="new-prop-baths" type="text" placeholder="e.g., 2" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Balcony</label><input
                                        id="new-prop-balcony" type="text" placeholder="e.g., 1"
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                                </div>
                                <div><label
                                        style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Furnishing
                                        *</label><select id="new-prop-furnishing" required
                                        style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;appearance:auto;">
                                        <option>Unfurnished</option>
                                        <option>Semi-Furnished</option>
                                        <option>Fully Furnished</option>
                                    </select></div>
                            </div>
                        </div>
                        <!-- Property Description -->
                        <div class="card" style="margin-bottom:1.5rem;">
                            <h2
                                style="font-size:1.125rem;font-weight:700;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                                <span style="color:#1DB954;">📝</span> Property Description
                            </h2>
                            <div><label
                                    style="display:block;font-size:0.875rem;color:#9ca3af;margin-bottom:0.5rem;">Description</label><textarea
                                    id="new-prop-description" rows="5" required minlength="20"
                                    placeholder="Describe your property, its features, amenities, and any additional information (min 20 characters)..."
                                    style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;resize:vertical;"></textarea>
                            </div>
                        </div>
                        <!-- Property Images -->
                        <div class="card" style="margin-bottom:1.5rem;border-style:dashed;">
                            <h2
                                style="font-size:1.125rem;font-weight:700;margin-bottom:0.5rem;display:flex;align-items:center;gap:0.5rem;">
                                <span style="color:#1DB954;">🖼️</span> Property Photos
                            </h2>
                            <p style="color:#9ca3af;font-size:0.8125rem;margin-bottom:1rem;">Photos buyers will see on the listing. JPG, PNG, or WEBP — up to 10MB each.</p>
                            <input type="file" id="new-prop-images" multiple accept=".jpg,.jpeg,.png,.webp"
                                style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                            <p style="color:#666;font-size:0.75rem;margin-top:0.5rem;">Uploaded automatically once the listing is created below. Public — shown to buyers.</p>
                        </div>
                        <!-- Verification Documents -->
                        <div class="card" style="margin-bottom:1.5rem;border-style:dashed;">
                            <h2
                                style="font-size:1.125rem;font-weight:700;margin-bottom:0.5rem;display:flex;align-items:center;gap:0.5rem;">
                                <span style="color:#1DB954;">📄</span> Verification Documents
                            </h2>
                            <p style="color:#9ca3af;font-size:0.8125rem;margin-bottom:1rem;">Upload proof of ownership (deed, tax receipt, ID) so an admin can verify this listing. PDF, JPG, or PNG — up to 10MB each.</p>
                            <input type="file" id="new-prop-documents" multiple accept=".pdf,.jpg,.jpeg,.png,.webp"
                                style="width:100%;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;padding:0.75rem 1rem;color:#fff;font-size:0.875rem;">
                            <p style="color:#666;font-size:0.75rem;margin-top:0.5rem;">Uploaded automatically once the listing is created below. Private — only visible to admins (never shown to buyers).</p>
                        </div>
                        <!-- Action Buttons -->
                        <div style="display:flex;gap:1rem;">
                            <button type="button" class="btn-outline"
                                onclick="switchPage(event,'my-listings')">Cancel</button>
                            <button type="submit" class="btn-primary" id="submit-new-property-btn">Submit for Review</button>
                        </div>
                    </form>
                </div>
            </div>

