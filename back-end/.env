# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated list of origins allowed to call the API via CORS.
# Not needed if you serve the frontend from this same server (default setup).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── MongoDB ─────────────────────────────────────────────────────────────
# Local MongoDB (default): mongodb://127.0.0.1:27017/real_estate
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/real_estate
MONGODB_URI=mongodb://127.0.0.1:27017/real_estate

# ─── JWT Auth ────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=ee0df0516cafe176ecdecefa110bdf02d027856e503654f7e0aae6ab1f3e7236
JWT_EXPIRES_IN=1d

# ─── Seed data (npm run seed) ───────────────────────────────────────────
# One admin per launch city — adminhyd@ / adminchn@ / adminb@ / adminkoc@,
# defined in src/config/configuration.ts (cityAdmins). Only their shared
# password is configurable here; the emails and cities are fixed alongside
# the ServiceCity list they belong to.
ADMIN_SEED_PASSWORD=123456789

SUPERUSER_SEED_NAME=Super Admin
SUPERUSER_SEED_EMAIL=superuser@gmail.com
SUPERUSER_SEED_PASSWORD=123456789
