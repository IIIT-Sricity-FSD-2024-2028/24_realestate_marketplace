# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
# The admin and superuser portals get their own port too, purely for a
# distinct/memorable URL per role — same app, same routes, same API on every
# port (not an access boundary; every page still works on every port).
ADMIN_PORT=3001
SUPERUSER_PORT=3002
# 0.0.0.0 works for both local dev and deployment (PaaS/containers need it —
# their reverse proxy can't reach a server bound to loopback-only 127.0.0.1).
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of origins allowed to call the API via CORS.
# Not needed if you serve the frontend from this same server (default setup).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── MongoDB ─────────────────────────────────────────────────────────────
# Local MongoDB (default): mongodb://127.0.0.1:27017/real_estate
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/real_estate
MONGODB_URI=mongodb://127.0.0.1:27017/real_estate

# ─── JWT Auth ────────────────────────────────────────────────────────────
# REQUIRED when NODE_ENV=production — the app refuses to boot with
# NODE_ENV=production unless this is set to something other than the
# insecure default baked into config/configuration.ts.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d

# ─── Seed data (npm run seed) ───────────────────────────────────────────
# One admin per launch city — adminhyd@ / adminchn@ / adminb@ / adminkoc@,
# defined in src/config/configuration.ts (cityAdmins). Only their shared
# password is configurable here; the emails and cities are fixed alongside
# the ServiceCity list they belong to.
ADMIN_SEED_PASSWORD=123456789

SUPERUSER_SEED_NAME=Super Admin
SUPERUSER_SEED_EMAIL=superuser@gmail.com
SUPERUSER_SEED_PASSWORD=123456789

# ─── Email (password reset) ─────────────────────────────────────────────
# Public base URL used to build the password-reset link sent by email.
# Point this at wherever the frontend is actually served.
APP_URL=http://localhost:3000

# SMTP credentials for sending the password-reset email. If left unset, the
# email is logged to the server console instead of actually sent — fine for
# local dev, but required in any deployment where users need to receive it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=truEstate <no-reply@truestate.local>

# ─── Payment gateway (revenue model) ────────────────────────────────────
# Leave BOTH of these blank and the app runs on its built-in offline gateway.
# That is not a stub: it implements Razorpay's real protocol — server-created
# orders and HMAC-SHA256 signatures over `order_id|payment_id` — so every
# checkout, verification, receipt and revenue figure works end to end with no
# account, no keys and no real money. The dashboards show a TEST MODE banner.
#
# To go live, create a Razorpay account (https://dashboard.razorpay.com),
# copy your API keys in and restart. Nothing else changes: the same checkout
# call now opens Razorpay's hosted widget and the same endpoint verifies the
# signature it returns. `rzp_test_...` keys still move no real money;
# `rzp_live_...` keys do.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you register the webhook at POST /api/v1/payments/webhook.
# It is the safety net for a customer who pays and then closes the tab before
# the browser can confirm back to us. Signed with its OWN secret, not the key
# secret above.
RAZORPAY_WEBHOOK_SECRET=

# ─── Logging (files written by common/logging/file-logger.ts) ───────────
# Directory holding the four log channels (relative to the project root, or an
# absolute path such as /var/log/truestate):
#   logs/http/   one line per HTTP request        logs/error/  errors + stack traces
#   logs/app/    application/framework output     logs/audit/  security-relevant events
LOG_DIR=logs
# How often buffered lines are written to disk, in ms. Errors bypass the
# buffer and are written immediately.
LOG_FLUSH_INTERVAL_MS=5000
# A log file is rotated to <name>.1.log once it would exceed this size.
LOG_MAX_FILE_SIZE_MB=5
# Log files older than this are deleted automatically.
LOG_RETENTION_DAYS=14
# Flush early if this many lines pile up between intervals.
LOG_MAX_BUFFERED_LINES=200
# Set true to also log every .css/.js/.png fetch (very noisy — off by default).
LOG_STATIC_ASSETS=false
# Set true to record request headers (Authorization/Cookie are redacted).
LOG_HTTP_HEADERS=false

# ─── Uploads & request limits (security + file-upload middleware) ───────
MAX_UPLOAD_FILE_MB=10
MAX_UPLOAD_FILES=10
MAX_JSON_BODY_KB=256
MAX_URL_LENGTH=2048

# ─── Static asset rate limiting ──────────────────────────────────────────
# Applies to files served from ../front-end/ and uploads/ — the paths Nest's
# ThrottlerGuard structurally cannot see (see StaticRateLimitMiddleware).
# API routes under /api/v1 are limited separately by ThrottlerModule.
STATIC_RATE_LIMIT=100
STATIC_RATE_LIMIT_TTL_MS=60000
